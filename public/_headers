# Cloudflare Pages: HTTP headers. This file is read by Pages and not served.
# "! Header" removes a header Pages adds by default (Access-Control-Allow-Origin: *).
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY
  ! Access-Control-Allow-Origin

# Font: cached for a year (rename the file, -v2, if it changes)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
